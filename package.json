{
  "name": "@hiddenability/opinionated-defaults",
  "version": "0.0.0",
  "description": "Opinionated default configurations for webdev tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiddenAbilitree/opinionated-defaults.git"
  },
  "bin": "dist/cli/index.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "import": {
        "default": "./dist/oxlint/index.mjs",
        "types": "./dist/oxlint/index.d.ts"
      }
    },
    "./oxfmt": {
      "import": {
        "default": "./dist/oxfmt/index.mjs",
        "types": "./dist/oxfmt/index.d.ts"
      }
    }
  },
  "scripts": {
    "test-cli": "bun dist/cli/index.mjs",
    "build": "bun ./scripts/build.ts && bun test",
    "prepack": "bun ./scripts/build.ts && bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "consola": "^3.4.2",
    "eslint-plugin-solid": "^0.14.5",
    "oxc-transform": "^0.144.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "eslint-plugin-solid": "^0.14.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-solid": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  }
}
